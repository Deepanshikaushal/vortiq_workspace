# ==========================================
# VortiQ Studio Environment Variables (.env)
# ==========================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (Defaults to H2 In-Memory)
SPRING_DATASOURCE_URL=jdbc:h2:mem:taskpulsedb
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Optional PostgreSQL / MySQL Production Overrides
# SPRING_DATASOURCE_URL=jdbc:postgresql://db-host:5432/vortiq_production
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=vortiq_user
# SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Frontend API Endpoint Override (Optional)
VITE_API_BASE_URL=/api
